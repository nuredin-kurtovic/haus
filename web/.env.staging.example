# HAUS staging env. Kopiraj u .env na serveru i popuni prazna polja.
APP_NAME=HAUS
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.ba

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=haus
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=redis
CACHE_STORE=redis
DB_QUEUE_TABLE=queue_jobs

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Dok nema SMTP-a mejlovi idu u storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@haus.ba"
MAIL_FROM_NAME="${APP_NAME}"

# Plaćanje: fake dok Monri ne da staging kredencijale.
# Napomena: dev/fake-payment ruta radi samo uz APP_DEBUG=true,
# pa je na stagingu kartični krug zatvoren; uplatnica radi normalno.
HAUS_PAYMENT_GATEWAY=fake
HAUS_FAKE_GATEWAY_SECRET=
HAUS_FAKE_CHARGE_OUTCOME=approved
HAUS_DISPATCHER_EMAIL=dispecer@haus.ba
HAUS_BANK_ACCOUNT=1610000000000000
HAUS_COMPANY_NAME="HAUS d.o.o."

MONRI_KEY=
MONRI_AUTHENTICITY_TOKEN=
MONRI_API_BASE=https://ipgtest.monri.com
MONRI_WEBPAY_BASE=https://ipgtest.monri.com
MONRI_CURRENCY=BAM
